# Google Gemini API Key (Get yours free from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key

# Default Gemini Model (options: models/gemini-3.1-flash-lite, models/gemini-3.8-flash, models/gemini-flash-latest)
GEMINI_MODEL=models/gemini-3.1-flash-lite

# Admin Web Portal Password
ADMIN_PASSWORD=admin123

# Server Settings
HOST=127.0.0.1
PORT=8000
